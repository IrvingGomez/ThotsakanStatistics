# Copy to `.env` (git-ignored) and fill in. Used by docker compose AND by local
# `uvicorn` runs. Never commit the real .env.

# ── Google sign-in ─────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create credentials →
# OAuth client ID → "Web application". Add these Authorized JavaScript origins:
#   http://localhost:8080   (docker compose, production-style)
#   http://localhost:5173   (dev server / docker-compose.dev.yml)
#   https://<your-production-domain>
# No client secret is needed (ID-token flow); the client ID is public by design.
GOOGLE_CLIENT_ID=

# Only emails ending in @<this domain> may sign in.
AUTH_ALLOWED_DOMAIN=cmkl.ac.th

# Signs our session cookie. Required, >= 32 chars. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
AUTH_SECRET_KEY=

# Hours a login stays valid.
AUTH_SESSION_HOURS=12

# Set to true when served over HTTPS (cookie is then HTTPS-only).
AUTH_COOKIE_SECURE=false

# Local-development escape hatch: skips login entirely. NEVER true in production.
AUTH_DISABLED=false

# Registry the base images (python, node, nginx) are pulled from. Default is
# Google's mirror of Docker Hub official images (no login needed). If it ever
# rate-limits you, try public.ecr.aws/docker/library.
# Use docker.io/library to go back to Docker Hub.
BASE_REGISTRY=mirror.gcr.io/library

# Host port for the production-style compose stack.
WEB_PORT=8080
