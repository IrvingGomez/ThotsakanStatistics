# Public demo (events): a second, login-free copy of the app beside the real one.
# Copy to `.env.demo` (git-ignored) and start it as its own compose project:
#   docker compose -p thotsakan-demo --env-file .env.demo up -d --build
# Stop it after the event:
#   docker compose -p thotsakan-demo --env-file .env.demo down
# See docs/AUTH.md, "Demo mode".

# No sign-in, a neutral "Demo" badge, and the limits below. No Google credentials needed.
DEMO_MODE=true

# Largest CSV the backend accepts, and the memory all open datasets may use together
# (the least recently used are dropped first). Defaults in demo mode: 10 and 1024.
MAX_UPLOAD_MB=10
SESSION_MEMORY_MB=1024

# nginx: keep the body limit a little above MAX_UPLOAD_MB so the app, not nginx, explains
# a refusal. Uploads per client IP; visitors on one Wi-Fi share an IP, so keep it generous.
CLIENT_MAX_BODY_SIZE=11m
UPLOAD_RATE_LIMIT=120r/m

# Its own port, so it runs next to the real app (default 8080).
WEB_PORT=8081

BASE_REGISTRY=mirror.gcr.io/library
